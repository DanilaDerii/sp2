@startuml

' Diagram type: Level-1 Data Flow Diagram (DFD)
' Scope: Complete SP2 ingestion, from source selection through local installation.
' Every visible arrow represents data, not execution control.

title SP2 Content Ingestion - Level 1 Data Flow Diagram

top to bottom direction
skinparam defaultFontName SansSerif
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 12
skinparam linetype ortho
skinparam ArrowColor #334155
skinparam ArrowFontColor #334155
skinparam rectangle {
  BorderColor #475569
  FontColor #0F172A
}
skinparam database {
  BackgroundColor #ECFDF5
  BorderColor #047857
  FontColor #064E3B
}
skinparam folder {
  BackgroundColor #FEFCE8
  BorderColor #A16207
  FontColor #713F12
}
skinparam frame {
  BackgroundColor #F8FAFC
  BorderColor #1D4ED8
  FontColor #1E3A8A
}

rectangle "<b>Teacher / LM Studio Caller</b>\nExternal entity" as caller_in #FFF7ED
folder "<b>D0 - Local Source Files</b>\nPDF, ODT, DOCX, PPTX" as source_store
rectangle "<b>LM Studio Embedding Service</b>\nExternal entity" as embedding_service #FFF7ED

frame "<b>SP2 Content Ingestion</b>" {
  rectangle "<b>1.0 Source Intake and Extraction</b>\nValidate source and extract normalized content" as p1 #DBEAFE

  rectangle "<b>2.0 Chunk and Embedding Creation</b>\nCreate chunks and pair them with vectors" as p2 #DBEAFE

  rectangle "<b>3.0 Portable Pack Construction</b>\nBuild metadata and export the ZIP artifact" as p3 #DBEAFE

  folder "<b>D1 - ZIP Artifact Storage</b>\nPortable course-pack ZIP" as artifact_store

  rectangle "<b>4.0 Pack Validation and Installation</b>\nValidate and install the course pack locally" as p4 #DBEAFE

  folder "<b>D2 - Installed Pack Files</b>\npack.json, chunks.json, vectors.npy" as installed_files
  database "<b>D3 - SQLite</b>\nInstalled-pack metadata" as sqlite
  database "<b>D4 - LanceDB</b>\nSearchable chunks and vectors" as lancedb

  p1 -[hidden]down-> p2
  p2 -[hidden]down-> p3
  p3 -[hidden]down-> artifact_store
  artifact_store -[hidden]down-> p4

  installed_files -[hidden]right-> sqlite
  sqlite -[hidden]right-> lancedb
}

rectangle "<b>Teacher / LM Studio Caller</b>\nSame external entity" as caller_out #FFF7ED

caller_in --> p1 : Source path and pack settings
source_store --> p1 : Source document bytes
p1 --> p2 : Extracted pages and source metadata

p2 --> embedding_service : Document-prefixed chunk texts
embedding_service --> p2 : Embedding vectors

p2 --> p3 : Chunk-vector records and embedding dimension
p3 --> artifact_store : Pack metadata, chunk records, and vectors
artifact_store --> p4 : Portable course-pack ZIP

p4 --> installed_files : Validated pack files
p4 --> sqlite : Installed-pack metadata
p4 --> lancedb : Searchable chunks and vectors
p4 --> caller_out : Pack ID, metadata, chunk count, model, dimension, and paths

note right of p4
  Installation consistency rule:
  if installation fails, SP2 removes
  partial files, SQLite rows, and
  LanceDB rows.
end note

legend bottom
  |= Element |= DFD meaning |
  | Blue rectangle | SP2 process |
  | Orange rectangle | External entity |
  | Folder / database | Data store |
  | Labelled arrow | Data flow |
endlegend

@enduml
